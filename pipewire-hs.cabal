cabal-version: 3.4

name:           pipewire-hs
version:        0.0.0.0
synopsis:       Haskell bindings for the PipeWire multimedia framework
description:    Type-safe Haskell bindings to the PipeWire C API, providing
                access to PipeWire's audio/video processing capabilities and
                session management.
category:       Sound
homepage:       https://github.com/JonathanLorimer/pipewire-hs#readme
bug-reports:    https://github.com/JonathanLorimer/pipewire-hs/issues
maintainer:     Jonathan Lorimer <jonathanlorimer@pm.me>
license:        BSD-3-Clause
build-type:     Simple
extra-source-files:
  README.md
  CHANGELOG.md
  docs/*.md

source-repository head
  type: git
  location: https://github.com/username/pipewire-hs.git

flag examples
  description: Build example programs
  default: False
  manual: True

common common-opts
  build-depends:
      base >= 4.14 && < 5

    -- Codecs
    , aeson
    , deriving-aeson
    , binary

    -- Parallelism
    , async

    -- Mutability
    , primitive
    , stm

    -- Binary
    , bytestring
    , vector

    -- Containers
    , containers
    , unordered-containers

    -- Utilities
    , text
    , foldl
    , safe-exceptions

  default-language: Haskell2010
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import: common-opts

  -- cabal-fmt: expand src
  exposed-modules:
      PipeWire.Core
      PipeWire.Context
      PipeWire.Loop
      PipeWire.Node
      PipeWire.Port
      PipeWire.Link
      PipeWire.Registry
      PipeWire.Raw.Core
      PipeWire.Raw.Context
      PipeWire.Raw.Loop
      PipeWire.Raw.Node
      PipeWire.Raw.Port
      PipeWire.Raw.Link
      PipeWire.Raw.Registry

  hs-source-dirs:
      src

  extra-libraries:
      pipewire-0.3

  pkgconfig-depends:
      libpipewire-0.3 >= 0.3.0

  c-sources:
      -- Uncomment if needed for extra C helpers
      -- cbits/helpers.c

executable pipewire-hs
  import: common-opts
  main-is: Main.hs
  hs-source-dirs:
      app
  build-depends: pipewire-hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N

executable simple-client
  import: common-opts
  main-is: SimpleClient.hs
  hs-source-dirs:
      examples
  build-depends: pipewire-hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  if !flag(examples)
    buildable: False

test-suite pipewire-hs-tests
  import: common-opts
  type: exitcode-stdio-1.0
  hs-source-dirs: test

  ghc-options:
    -Wall -threaded -rtsopts -with-rtsopts=-N -fdefer-typed-holes -O0

  main-is: Main.hs

  -- cabal-fmt: expand test -Main
  other-modules:
    CoreSpec
    Spec

  build-depends:
    , pipewire-hs
    , hedgehog
    , hspec
    , hspec-core
    , hspec-discover
    , hspec-expectations
    , hspec-hedgehog
